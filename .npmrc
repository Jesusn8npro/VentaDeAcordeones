# El servidor de despliegue ejecuta `npm install` a secas (ignora los `cmds` del
# nixpacks.toml, como se ve en el log del build). Sin esto, npm aborta con ERESOLVE en
# cuanto una dependencia declara un peer antiguo y el deploy entero falla.
# Mismo contenido que el .npmrc de AcademiaNext, que despliega sin problemas.
engine-strict=false
legacy-peer-deps=true
